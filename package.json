{
  "name": "slice-even",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p packages/core && tsc -p apps/web",
    "export:apples": "node packages/core/scripts/export-apples.ts",
    "dev": "npm run dev -w @slice-even/web",
    "functions:sync": "node scripts/sync-core.mjs",
    "functions:deploy": "npm run functions:sync && npx supabase functions deploy submit-cut --project-ref ohhwwzyzyzqgstothllx --use-api"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
