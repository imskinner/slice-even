{
  "name": "slice-even",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p packages/core && tsc -p apps/web && tsc -p apps/server",
    "export:apples": "node packages/core/scripts/export-apples.ts",
    "dev": "npm run dev -w @slice-even/web",
    "deploy:pages": "node scripts/deploy-pages.mjs",
    "server:dev": "npm run dev -w @slice-even/server",
    "server:deploy": "npm run deploy -w @slice-even/server"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
